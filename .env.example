# ─── Discord ─────────────────────────────────────────────────────────────────
# Bot token from https://discord.com/developers/applications → your app → Bot.
# One token per machine: Domin's bot and Jacek's bot are separate applications.
# The "Message Content Intent" toggle on that page must be ON, otherwise the bot
# receives empty message content and never reacts to a mention.
DISCORD_BOT_TOKEN=

# Server (guild) ID. Enable Developer Mode in Discord
# (User Settings → Advanced), then right-click the server → Copy Server ID.
# Slash commands are registered per guild, so this must be the shared server.
DISCORD_GUILD_ID=

# Comma-separated Discord user IDs allowed to drive this bot.
# Right-click a user → Copy User ID. Put BOTH of you here on BOTH bots so either
# of you can call either machine. This whitelist is the only thing standing
# between a server member and shell access on this machine — keep it tight.
ALLOWED_USER_IDS=

# Root directory for projects. /register only accepts paths inside it.
BASE_PROJECT_DIR=/home/domin/startups

# ─── Claude ──────────────────────────────────────────────────────────────────
# Auth comes from the Claude Code CLI login on this machine (Pro/Max
# subscription) — run `claude login` once. ANTHROPIC_API_KEY is deliberately
# stripped from the subprocess environment, so setting one here does nothing.

# Estimated cost shown in each result embed. Meaningless on a Max plan.
SHOW_COST=false

# Pin a model, or leave blank for the CLI default.
# Examples: claude-opus-5, claude-sonnet-5, claude-haiku-4-5-20251001
CLAUDE_MODEL=

# ─── Limits ──────────────────────────────────────────────────────────────────
# Messages per user per minute before the bot starts refusing.
RATE_LIMIT_PER_MINUTE=10
